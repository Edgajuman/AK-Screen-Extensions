{
  "schema": 1,
  "sdk": 1,
  "id": "edgajuman.motion-kit",
  "name": "Motion Kit",
  "author": "dehuman",
  "version": "1.3.0",
  "min_app": "2.4.0",
  "description": "Presets editables para capas 3D, cámara de composición, rótulos y acabados de movimiento.",
  "license": "MIT",
  "widgets": [
    {
      "id": "parallax",
      "title": "Parallax · capa 3D",
      "controls": [
        {
          "id": "depth",
          "kind": "number",
          "label": "Profundidad Z (px)",
          "value": 180,
          "min": -5000,
          "max": 5000
        },
        {
          "id": "x",
          "kind": "number",
          "label": "Rotación X (°)",
          "value": 12,
          "min": -180,
          "max": 180
        },
        {
          "id": "y",
          "kind": "number",
          "label": "Rotación Y (°)",
          "value": -20,
          "min": -180,
          "max": 180
        },
        {
          "id": "apply",
          "kind": "button",
          "label": "Aplicar a capa seleccionada",
          "action": "apply-layer"
        },
        {
          "id": "front",
          "kind": "button",
          "label": "Restablecer plano frontal",
          "action": "front"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "camera-space",
      "title": "Cámara de composición",
      "controls": [
        {
          "id": "camera3d",
          "kind": "button",
          "label": "Activar perspectiva 3D",
          "action": "camera3d"
        },
        {
          "id": "orbit",
          "kind": "button",
          "label": "Órbita diagonal",
          "action": "orbit"
        },
        {
          "id": "camera2d",
          "kind": "button",
          "label": "Volver a cámara 2D",
          "action": "camera2d"
        },
        {
          "id": "reset-camera",
          "kind": "button",
          "label": "Centrar y restablecer cámara",
          "action": "reset-camera"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "title-card",
      "title": "Título cinético",
      "controls": [
        {
          "id": "text",
          "kind": "text",
          "label": "Texto",
          "value": "Un nuevo capítulo"
        },
        {
          "id": "font",
          "kind": "text",
          "label": "Fuente",
          "value": "Inter"
        },
        {
          "id": "size",
          "kind": "number",
          "label": "Tamaño",
          "value": 112,
          "min": 12,
          "max": 1000
        },
        {
          "id": "color",
          "kind": "color",
          "label": "Color inicial",
          "value": [
            0.25,
            0.62,
            1,
            1
          ]
        },
        {
          "id": "color2",
          "kind": "color",
          "label": "Color final",
          "value": [
            0.7,
            0.35,
            1,
            1
          ]
        },
        {
          "id": "outline",
          "kind": "number",
          "label": "Contorno (px)",
          "value": 2,
          "min": 0,
          "max": 40
        },
        {
          "id": "create",
          "kind": "button",
          "label": "Crear título animado",
          "action": "create-title"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "movement",
      "title": "Movimiento · acabado",
      "controls": [
        {
          "id": "shake",
          "kind": "button",
          "label": "Movimiento de cámara",
          "action": "shake"
        },
        {
          "id": "blur",
          "kind": "button",
          "label": "Desenfoque de movimiento",
          "action": "motion-blur"
        },
        {
          "id": "glow",
          "kind": "button",
          "label": "Resplandor",
          "action": "glow"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    }
  ],
  "actions": [
    {
      "id": "apply-layer",
      "title": "Aplicar transformación 3D",
      "commands": [
        {
          "id": "camera.layer",
          "params": {
            "props": {
              "depth": "$ui.parallax.depth",
              "rot_x": "$ui.parallax.x",
              "rot_y": "$ui.parallax.y",
              "rot_z": 0
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "front",
      "title": "Plano frontal",
      "commands": [
        {
          "id": "camera.layer",
          "params": {
            "props": {
              "depth": 0,
              "rot_x": 0,
              "rot_y": 0,
              "rot_z": 0
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "camera3d",
      "title": "Activar cámara 3D",
      "commands": [
        {
          "id": "camera.set",
          "params": {
            "props": {
              "mode": 1,
              "zoom": 100,
              "focal": 1600,
              "projection": 0
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "orbit",
      "title": "Órbita diagonal",
      "commands": [
        {
          "id": "camera.set",
          "params": {
            "props": {
              "mode": 1,
              "rot_x": 8,
              "rot_y": -12,
              "rot_z": 0,
              "zoom": 100,
              "focal": 1600,
              "projection": 0
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "camera2d",
      "title": "Cámara 2D",
      "commands": [
        {
          "id": "camera.set",
          "params": {
            "props": {
              "mode": 0,
              "rot_x": 0,
              "rot_y": 0,
              "rot_z": 0,
              "zoom": 100
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "reset-camera",
      "title": "Restablecer cámara",
      "commands": [
        {
          "id": "camera.set",
          "params": {
            "props": {
              "mode": 0,
              "position": [
                0,
                0
              ],
              "z": 0,
              "rot_x": 0,
              "rot_y": 0,
              "rot_z": 0,
              "zoom": 100
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "create-title",
      "title": "Crear título animado",
      "commands": [
        {
          "id": "graphics.newText",
          "params": {
            "text": "$ui.title-card.text",
            "size": "$ui.title-card.size",
            "font": "$ui.title-card.font"
          }
        },
        {
          "id": "graphics.set",
          "params": {
            "props": {
              "fill_color": "$ui.title-card.color",
              "gradient_type": 1,
              "gradient_color2": "$ui.title-card.color2",
              "stroke": true,
              "stroke_width": "$ui.title-card.outline",
              "text_animation": 2,
              "animation_auto": true,
              "animation_duration": 1.2
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "shake",
      "title": "Movimiento de cámara",
      "commands": [
        {
          "id": "effects.apply",
          "params": {
            "effect": "camera_shake"
          }
        }
      ],
      "requests": []
    },
    {
      "id": "motion-blur",
      "title": "Desenfoque de movimiento",
      "commands": [
        {
          "id": "effects.apply",
          "params": {
            "effect": "layer_motion_blur"
          }
        }
      ],
      "requests": []
    },
    {
      "id": "glow",
      "title": "Resplandor",
      "commands": [
        {
          "id": "effects.apply",
          "params": {
            "effect": "wonder_glow"
          }
        }
      ],
      "requests": []
    }
  ],
  "permissions": {
    "project_edit": true
  },
  "changelog": "AK Screen 2.4.0 revisada: estilos CSS por widget, panel / flotante, menú agrupado por extensión y versiones en catálogo. 1.0.0: cuatro widgets para parallax 3D, cámara, títulos animados y acabados de movimiento."
}
