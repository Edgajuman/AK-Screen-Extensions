{
  "schema": 1,
  "sdk": 1,
  "id": "edgajuman.color-workbench",
  "name": "Color Workbench",
  "author": "dehuman",
  "version": "1.3.0",
  "min_app": "2.4.0",
  "description": "Accesos de color y acabado visual no destructivo para la selección actual.",
  "license": "MIT",
  "widgets": [
    {
      "id": "cinema",
      "title": "Look cinematográfico",
      "controls": [
        {
          "id": "base",
          "kind": "button",
          "label": "Añadir corrección Lumetri",
          "action": "lumetri"
        },
        {
          "id": "vignette",
          "kind": "button",
          "label": "Añadir viñeta",
          "action": "vignette"
        },
        {
          "id": "grain",
          "kind": "button",
          "label": "Añadir grano de película",
          "action": "grain"
        },
        {
          "id": "cinema-stack",
          "kind": "button",
          "label": "Look completo · color + viñeta + grano",
          "action": "cinema-stack"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "focus",
      "title": "Lente y profundidad",
      "controls": [
        {
          "id": "bokeh",
          "kind": "button",
          "label": "Desenfoque bokeh",
          "action": "bokeh"
        },
        {
          "id": "focus-blur",
          "kind": "button",
          "label": "Desenfoque de foco",
          "action": "focus-blur"
        },
        {
          "id": "glow",
          "kind": "button",
          "label": "Resplandor de altas luces",
          "action": "glow"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "composite",
      "title": "Composición y limpieza",
      "controls": [
        {
          "id": "unmult",
          "kind": "button",
          "label": "Eliminar fondo negro/blanco",
          "action": "unmult"
        },
        {
          "id": "blur",
          "kind": "button",
          "label": "Desenfoque gaussiano",
          "action": "blur"
        },
        {
          "id": "channel-blur",
          "kind": "button",
          "label": "Desenfoque por canal RGB",
          "action": "channel-blur"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "motion-finish",
      "title": "Movimiento y textura",
      "controls": [
        {
          "id": "motion-blur",
          "kind": "button",
          "label": "Desenfoque de movimiento",
          "action": "motion-blur"
        },
        {
          "id": "camera-shake",
          "kind": "button",
          "label": "Movimiento de cámara",
          "action": "camera-shake"
        },
        {
          "id": "film-stack",
          "kind": "button",
          "label": "Textura de película · grano + viñeta",
          "action": "film-stack"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
