{
  "schema": 1,
  "sdk": 1,
  "id": "edgajuman.motion-titles",
  "name": "Motion Titles",
  "author": "edgajuman",
  "version": "1.3.1",
  "min_app": "2.4.0",
  "description": "Títulos con degradados, contorno y animación por caracteres.",
  "license": "MIT",
  "widgets": [
    {
      "id": "title",
      "title": "Motion Titles",
      "controls": [
        {
          "id": "text",
          "kind": "text",
          "label": "Texto",
          "value": "Título"
        },
        {
          "id": "size",
          "kind": "number",
          "label": "Tamaño",
          "value": 100,
          "min": 1,
          "max": 2000
        },
        {
          "id": "color",
          "kind": "color",
          "label": "Color",
          "value": [
            0.2,
            0.55,
            1,
            1
          ]
        },
        {
          "id": "color2",
          "kind": "color",
          "label": "Segundo color del degradado",
          "value": [
            1,
            0.3,
            0.55,
            1
          ]
        },
        {
          "id": "font",
          "kind": "text",
          "label": "Familia tipográfica",
          "value": "Inter"
        },
        {
          "id": "outline",
          "kind": "number",
          "label": "Contorno (px)",
          "value": 3,
          "min": 0,
          "max": 64
        },
        {
          "id": "duration",
          "kind": "number",
          "label": "Duración de entrada (s)",
          "value": 1.2,
          "min": 0.05,
          "max": 30
        },
        {
          "id": "create",
          "kind": "button",
          "label": "Crear título",
          "value": null,
          "action": "create"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "lower-third",
      "title": "Rótulo de identificación",
      "controls": [
        {
          "id": "text",
          "kind": "text",
          "label": "Nombre y cargo",
          "value": "Nombre · Cargo"
        },
        {
          "id": "font",
          "kind": "text",
          "label": "Familia tipográfica",
          "value": "Inter"
        },
        {
          "id": "size",
          "kind": "number",
          "label": "Tamaño",
          "value": 64,
          "min": 12,
          "max": 600
        },
        {
          "id": "color",
          "kind": "color",
          "label": "Color del texto",
          "value": [
            1,
            1,
            1,
            1
          ]
        },
        {
          "id": "background",
          "kind": "color",
          "label": "Color del fondo",
          "value": [
            0.02,
            0.05,
            0.1,
            0.9
          ]
        },
        {
          "id": "create",
          "kind": "button",
          "label": "Crear rótulo deslizante",
          "action": "lower-third"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "subtitle-card",
      "title": "Cartela de texto",
      "controls": [
        {
          "id": "text",
          "kind": "text",
          "label": "Texto en pantalla",
          "value": "Escribe aquí",
          "multiline": true
        },
        {
          "id": "size",
          "kind": "number",
          "label": "Tamaño",
          "value": 48,
          "min": 12,
          "max": 600
        },
        {
          "id": "opacity",
          "kind": "number",
          "label": "Opacidad del fondo (%)",
          "value": 78,
          "min": 0,
          "max": 100
        },
        {
          "id": "create",
          "kind": "button",
          "label": "Crear cartela",
          "action": "subtitle-card"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "selected-style",
      "title": "Estilo del texto seleccionado",
      "controls": [
        {
          "id": "shadow",
          "kind": "button",
          "label": "Sombra suave",
          "action": "shadow"
        },
        {
          "id": "background",
          "kind": "button",
          "label": "Fondo legible",
          "action": "background"
        },
        {
          "id": "outline",
          "kind": "button",
          "label": "Contorno blanco",
          "action": "outline"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    }
  ],
  "actions": [
    {
      "id": "create",
      "title": "Crear título",
      "commands": [
        {
          "id": "graphics.newText",
          "params": {
            "text": "$ui.title.text",
            "size": "$ui.title.size",
            "font": "$ui.title.font"
          }
        },
        {
          "id": "graphics.set",
          "params": {
            "props": {
              "fill_color": "$ui.title.color",
              "gradient_type": 1,
              "gradient_color2": "$ui.title.color2",
              "stroke": true,
              "stroke_width": "$ui.title.outline",
              "text_animation": 2,
              "animation_auto": true,
              "animation_duration": "$ui.title.duration"
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "lower-third",
      "title": "Crear rótulo de identificación",
      "commands": [
        {
          "id": "graphics.newText",
          "params": {
            "text": "$ui.lower-third.text",
            "size": "$ui.lower-third.size",
            "font": "$ui.lower-third.font"
          }
        },
        {
          "id": "graphics.set",
          "params": {
            "props": {
              "fill_color": "$ui.lower-third.color",
              "background": true,
              "background_color": "$ui.lower-third.background",
              "background_opacity": 88,
              "shadow": true,
              "text_animation": 3,
              "animation_auto": true,
              "animation_duration": 0.7
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "subtitle-card",
      "title": "Crear cartela legible",
      "commands": [
        {
          "id": "graphics.newText",
          "params": {
            "text": "$ui.subtitle-card.text",
            "size": "$ui.subtitle-card.size",
            "font": "Inter"
          }
        },
        {
          "id": "graphics.set",
          "params": {
            "props": {
              "fill_color": "#ffffff",
              "background": true,
              "background_color": "#101827",
              "background_opacity": "$ui.subtitle-card.opacity",
              "shadow": true,
              "text_animation": 1,
              "animation_auto": true,
              "animation_duration": 0.35
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "shadow",
      "title": "Sombra suave",
      "commands": [
        {
          "id": "graphics.set",
          "params": {
            "props": {
              "shadow": true,
              "shadow_color": "#000000",
              "shadow_opacity": 72,
              "shadow_blur": 18
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "background",
      "title": "Fondo legible",
      "commands": [
        {
          "id": "graphics.set",
          "params": {
            "props": {
              "background": true,
              "background_color": "#101827",
              "background_opacity": 82
            }
          }
        }
      ],
      "requests": []
    },
    {
      "id": "outline",
      "title": "Contorno blanco",
      "commands": [
        {
          "id": "graphics.set",
          "params": {
            "props": {
              "stroke": true,
              "stroke_color": "#ffffff",
              "stroke_width": 2
            }
          }
        }
      ],
      "requests": []
    }
  ],
  "permissions": {
    "project_edit": true
  },
  "changelog": "1.3.1: autor corregido a @edgajuman; conserva el identificador, permisos y datos locales. AK Screen 2.4.0 revisada: estilos CSS por widget, panel / flotante, menú agrupado por extensión y versiones en catálogo. 1.2.0: añade widgets de rótulos, cartelas legibles y estilos rápidos aplicables al texto seleccionado."
}
