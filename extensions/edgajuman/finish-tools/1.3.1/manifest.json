{
  "schema": 1,
  "sdk": 1,
  "id": "edgajuman.finish-tools",
  "name": "Finish Tools",
  "author": "edgajuman",
  "version": "1.3.1",
  "min_app": "2.4.0",
  "description": "Grano de película y limpieza de fondo.",
  "license": "MIT",
  "widgets": [
    {
      "id": "finish",
      "title": "Acabado",
      "controls": [
        {
          "id": "grain",
          "kind": "button",
          "label": "Añadir grano",
          "value": null,
          "action": "grain"
        },
        {
          "id": "unmult",
          "kind": "button",
          "label": "Eliminar fondo negro",
          "value": null,
          "action": "unmult"
        },
        {
          "id": "blur",
          "kind": "button",
          "label": "Desenfoque suave",
          "action": "blur"
        },
        {
          "id": "glow",
          "kind": "button",
          "label": "Resplandor",
          "action": "glow"
        },
        {
          "id": "shake",
          "kind": "button",
          "label": "Movimiento de cámara",
          "action": "shake"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "texture",
      "title": "Textura y atmósfera",
      "controls": [
        {
          "id": "vignette",
          "kind": "button",
          "label": "Viñeta cinematográfica",
          "action": "vignette"
        },
        {
          "id": "bokeh",
          "kind": "button",
          "label": "Desenfoque bokeh",
          "action": "bokeh"
        },
        {
          "id": "motion-blur",
          "kind": "button",
          "label": "Desenfoque de movimiento",
          "action": "motion-blur"
        },
        {
          "id": "channel-blur",
          "kind": "button",
          "label": "Desenfoque selectivo RGB",
          "action": "channel-blur"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    },
    {
      "id": "dialogue-quick",
      "title": "Audio · diálogo",
      "controls": [
        {
          "id": "denoise",
          "kind": "button",
          "label": "Reducción de ruido",
          "action": "denoise"
        },
        {
          "id": "dehum",
          "kind": "button",
          "label": "Reducción de zumbido",
          "action": "dehum"
        },
        {
          "id": "deess",
          "kind": "button",
          "label": "Control de sibilancias",
          "action": "deess"
        },
        {
          "id": "limiter",
          "kind": "button",
          "label": "Limitador de picos",
          "action": "limiter"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    }
  ],
