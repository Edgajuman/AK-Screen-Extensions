{
  "schema": 1,
  "sdk": 1,
  "id": "edgajuman.brand-titles",
  "name": "Brand Titles",
  "author": "edgajuman",
  "version": "1.3.1",
  "min_app": "2.4.0",
  "description": "Títulos de marca con degradados, contorno, fondo, fuente y entrada animada. Crea capas de texto editables sin descargar medios.",
  "license": "MIT",
  "widgets": [
    {
      "id": "title",
      "title": "Brand Titles",
      "controls": [
        {
          "id": "text",
          "kind": "text",
          "label": "Título",
          "value": "El siguiente capítulo"
        },
        {
          "id": "font",
          "kind": "text",
          "label": "Fuente",
          "value": "Inter"
        },
        {
          "id": "size",
          "kind": "number",
          "label": "Tamaño",
          "value": 110,
          "min": 12,
          "max": 800
        },
        {
          "id": "color",
          "kind": "color",
          "label": "Color inicial",
          "value": [
            0.22,
            0.55,
            1,
            1
          ]
        },
        {
          "id": "end",
          "kind": "color",
          "label": "Color final",
          "value": [
            0.67,
            0.36,
            1,
            1
          ]
        },
        {
          "id": "outline",
          "kind": "number",
          "label": "Contorno",
          "value": 2,
          "min": 0,
          "max": 50
        },
        {
          "id": "background",
          "kind": "checkbox",
          "label": "Fondo del título",
          "value": false
        },
        {
          "id": "create",
          "kind": "button",
          "label": "Crear título de marca",
          "value": null,
          "action": "create"
        }
      ],
      "surface": "both",
      "floating_theme": true,
      "layout": "controls",
      "css": ".widget { background-color: var(--panel); padding: 12px; border-radius: 12px; gap: 8px; } .widget-title { color: var(--accent); font-size: 16px; } .input { background-color: var(--field); border-color: var(--border); border-radius: 8px; } .button { background-color: var(--accent); border-radius: 8px; padding: 6px; } .control { padding: 4px; }"
    }
  ],
  "actions": [
    {
      "id": "create",
      "title": "Título con degradado y entrada",
      "commands": [
        {
          "id": "graphics.newText",
          "params": {
            "text": "$ui.title.text",
            "font": "$ui.title.font",
            "size": "$ui.title.size"
          }
        },
        {
          "id": "graphics.set",
          "params": {
            "props": {
              "gradient_type": 1,
              "fill_color": "$ui.title.color",
              "gradient_color2": "$ui.title.end",
              "stroke": true,
              "stroke_width": "$ui.title.outline",
              "background": "$ui.title.background",
              "background_color": [
                0.03,
                0.04,
                0.08,
                1
              ],
              "text_animation": 2,
              "animation_auto": true,
              "animation_duration": 1.2
            }
          }
        }
      ],
      "requests": []
    }
  ],
  "permissions": {
    "project_read": false,
    "project_edit": true,
    "render": false,
    "network": []
  },
  "files": [],
  "changelog": "1.3.1: autor corregido a @edgajuman; conserva el identificador, permisos y datos locales. AK Screen 2.4.0 revisada: estilos CSS por widget, panel / flotante, menú agrupado por extensión y versiones en catálogo. 2.4.0: widgets nativos, estilos CSS aislados, uso en panel o ventana flotante, datos conservados entre versiones."
}
